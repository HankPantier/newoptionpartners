<script>
/* ============================================================
   NewOption Partners — site behaviour
   HERE Maps: set HERE_API_KEY below (free key at developer.here.com).
   Restrict the key to your production domain in the HERE console.
   Until a key is set, the map area shows the styled address panel.
   ============================================================ */
var HERE_API_KEY = "hitUcQ4JMK5Enon9p8kmror_IXMsZDtFHVvBIgeNrJI";
var OFFICE = { lat: 40.0175384, lng: -105.2823651 };

(function(){
  var d=document, reduce=window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  /* ---------- image skeletons ---------- */
  function settle(img){
    var w=img.closest('.ph'); if(w) w.classList.add('is-loaded');
  }
  d.querySelectorAll('.ph>img').forEach(function(img){
    if(img.complete && img.naturalWidth>0){ settle(img); return; }
    img.addEventListener('load',function(){settle(img)},{once:true});
    img.addEventListener('error',function(){settle(img)},{once:true});
  });

  /* ---------- header: solid state + scroll progress ---------- */
  var hdr=d.getElementById('hdr'), hero=d.getElementById('top'), prog=d.getElementById('prog'), ticking=false;
  function onScroll(){
    if(ticking) return; ticking=true;
    requestAnimationFrame(function(){
      var y=window.scrollY;
      hdr.classList.toggle('solid', y > (hero?hero.offsetHeight-90:200));
      var max=d.body.scrollHeight-window.innerHeight;
      prog.style.transform='scaleX('+(max>0?Math.min(1,y/max):0)+')';
      ticking=false;
    });
  }
  window.addEventListener('scroll',onScroll,{passive:true});
  window.addEventListener('resize',onScroll); onScroll();

  /* ---------- mobile nav ---------- */
  var burger=d.getElementById('burger'), mnav=d.getElementById('mnav');
  function setMenu(open){
    mnav.classList.toggle('open',open);
    burger.setAttribute('aria-expanded',open?'true':'false');
    burger.setAttribute('aria-label',open?'Close menu':'Open menu');
    d.body.style.overflow=open?'hidden':'';
    /* header keeps whatever state the scroll position gave it, so the
       wordmark and the burger/X never change colour on open */
  }
  burger.addEventListener('click',function(){ setMenu(!mnav.classList.contains('open')); });
  mnav.querySelectorAll('a').forEach(function(a){ a.addEventListener('click',function(){ setMenu(false); }); });
  d.addEventListener('keydown',function(e){ if(e.key==='Escape'&&mnav.classList.contains('open')) setMenu(false); });

  /* ---------- hero carousel ---------- */
  var slides=[].slice.call(d.querySelectorAll('.slide')),
      dots=d.getElementById('dots'), cnum=d.getElementById('cnum'), i=0, timer=null, DUR=6000;

  slides.forEach(function(_,n){
    var b=d.createElement('button');
    b.className='dot'+(n===0?' on':''); b.innerHTML='<i></i>';
    b.setAttribute('aria-label','Show image '+(n+1)+' of '+slides.length);
    if(n===0) b.setAttribute('aria-current','true');
    b.addEventListener('click',function(){go(n)});
    dots.appendChild(b);
  });
  var dotEls=[].slice.call(dots.children);

  function go(n){
    if(n===i) return;
    slides[i].classList.remove('on');
    dotEls[i].classList.remove('on'); dotEls[i].removeAttribute('aria-current');
    i=(n+slides.length)%slides.length;
    slides[i].classList.add('on');
    var f=dotEls[i].querySelector('i');
    f.style.transition='none'; f.style.right='100%'; void f.offsetWidth; f.style.transition='';
    dotEls[i].classList.add('on'); dotEls[i].setAttribute('aria-current','true');
    cnum.textContent=String(i+1).padStart(2,'0');
    restart();
  }
  function next(){go(i+1)} function prev(){go(i-1)}
  function restart(){ if(reduce) return; clearInterval(timer); timer=setInterval(next,DUR); }

  d.getElementById('next').addEventListener('click',next);
  d.getElementById('prev').addEventListener('click',prev);
  d.addEventListener('keydown',function(e){
    if(mnav.classList.contains('open')) return;
    if(e.target && /^(INPUT|TEXTAREA)$/.test(e.target.tagName)) return;
    if(e.key==='ArrowRight')next(); if(e.key==='ArrowLeft')prev();
  });

  var sx=null;
  hero.addEventListener('touchstart',function(e){sx=e.touches[0].clientX},{passive:true});
  hero.addEventListener('touchend',function(e){
    if(sx===null)return; var dx=e.changedTouches[0].clientX-sx;
    if(Math.abs(dx)>50){ dx<0?next():prev(); } sx=null;
  },{passive:true});

  if('IntersectionObserver' in window){
    new IntersectionObserver(function(es){
      es.forEach(function(en){ en.isIntersecting?restart():clearInterval(timer); });
    },{threshold:.15}).observe(hero);
  }
  if(!reduce){ restart(); }
  d.addEventListener('visibilitychange',function(){ d.hidden?clearInterval(timer):restart(); });

  /* ---------- properties rail ---------- */
  var rail=d.getElementById('rail'), pp=d.getElementById('pprev'), pn=d.getElementById('pnext'), rbar=d.getElementById('railbar');
  function step(){ var c=rail.querySelector('.card'); return c?c.offsetWidth+24:320; }
  pn.addEventListener('click',function(){rail.scrollBy({left:step(),behavior:'smooth'})});
  pp.addEventListener('click',function(){rail.scrollBy({left:-step(),behavior:'smooth'})});
  function railState(){
    var maxS=rail.scrollWidth-rail.clientWidth;
    pp.disabled = rail.scrollLeft<8;
    pn.disabled = rail.scrollLeft >= maxS-8;
    var vis=Math.min(1,rail.clientWidth/rail.scrollWidth);
    rbar.style.width=(vis*100)+'%';
    rbar.style.transform='translateX('+(maxS>0?(rail.scrollLeft/maxS)*((1/vis)-1)*100:0)+'%)';
  }
  rail.addEventListener('scroll',railState,{passive:true});
  window.addEventListener('resize',railState); railState();

  /* ---------- bios ---------- */
  d.querySelectorAll('.bio-toggle').forEach(function(b){
    b.addEventListener('click',function(){
      var t=d.getElementById(b.getAttribute('aria-controls'));
      var open=t.classList.toggle('open');
      b.setAttribute('aria-expanded',open?'true':'false');
      b.querySelector('span').textContent=open?'Show less':'Read full bio';
    });
  });

  /* ---------- reveal on scroll ---------- */
  if('IntersectionObserver' in window){
    var io=new IntersectionObserver(function(es){
      es.forEach(function(en){ if(en.isIntersecting){ en.target.classList.add('in'); io.unobserve(en.target); } });
    },{threshold:.12,rootMargin:'0px 0px -60px'});
    d.querySelectorAll('.rv').forEach(function(el,n){ el.style.transitionDelay=(n%3*70)+'ms'; io.observe(el); });
  } else {
    d.querySelectorAll('.rv').forEach(function(el){el.classList.add('in')});
  }

  /* ---------- scrollspy ---------- */
  var links=[].slice.call(d.querySelectorAll('.nav a'));
  var targets=links.map(function(a){ return d.querySelector(a.getAttribute('href')); }).filter(Boolean);
  if('IntersectionObserver' in window && targets.length){
    var spy=new IntersectionObserver(function(es){
      es.forEach(function(en){
        if(!en.isIntersecting) return;
        links.forEach(function(a){ a.classList.toggle('active', a.getAttribute('href')==='#'+en.target.id); });
      });
    },{rootMargin:'-45% 0px -50% 0px'});
    targets.forEach(function(t){spy.observe(t)});
  }

  /* ---------- HERE map ---------- */
  var fb=d.getElementById('mapFallback');
  function loadScript(src){
    return new Promise(function(res,rej){
      var s=d.createElement('script'); s.src=src; s.async=false;
      s.onload=res; s.onerror=function(){rej(new Error('failed '+src))};
      d.head.appendChild(s);
    });
  }
  function initHere(){
    var base='https://js.api.here.com/v3/3.2/';
    var css=d.createElement('link'); css.rel='stylesheet'; css.href=base+'mapsjs-ui.css'; d.head.appendChild(css);
    return loadScript(base+'mapsjs-core.js')
      .then(function(){ return loadScript(base+'mapsjs-service.js'); })
      .then(function(){ return loadScript(base+'mapsjs-mapevents.js'); })
      .then(function(){ return loadScript(base+'mapsjs-ui.js'); })
      .then(function(){
        var platform=new H.service.Platform({ apikey: HERE_API_KEY });
        var layers=platform.createDefaultLayers();
        var map=new H.Map(
          d.getElementById('mapCanvas'),
          layers.vector.normal.map,
          { zoom:16, center:OFFICE, pixelRatio: window.devicePixelRatio||1 }
        );
        new H.mapevents.Behavior(new H.mapevents.MapEvents(map));
        var ui=H.ui.UI.createDefault(map, layers);
        ui.getControl('mapsettings').setVisibility(false);
        ui.getControl('scalebar').setVisibility(false);

        var svg='<svg xmlns="http://www.w3.org/2000/svg" width="34" height="44" viewBox="0 0 34 44">'+
          '<path d="M17 43C17 43 32 26.5 32 17A15 15 0 1 0 2 17c0 9.5 15 26 15 26Z" fill="#B08240" stroke="#0E1D26" stroke-width="2"/>'+
          '<circle cx="17" cy="17" r="5.5" fill="#F7F6F3"/></svg>';
        map.addObject(new H.map.Marker(OFFICE,{icon:new H.map.Icon(svg,{anchor:{x:17,y:44}})}));

        window.addEventListener('resize',function(){ map.getViewPort().resize(); });
        confirmPainted();
      });
  }

  /* Only swap the address panel for the map once tiles have actually arrived
     and a canvas has real dimensions. A silently blank map is worse than the
     panel, so if nothing paints within 8s we put the panel back. */
  function confirmPainted(){
    var started=Date.now(), tile=false, po=null;
    try{
      po=new PerformanceObserver(function(list){
        list.getEntries().forEach(function(e){ if(/hereapi\.com/.test(e.name)) tile=true; });
      });
      po.observe({type:'resource',buffered:true});
    }catch(_){ tile=true; }
    (function check(){
      var c=d.querySelector('#mapCanvas canvas');
      if(c && c.width>0 && tile){ if(po)po.disconnect(); fb.classList.add('gone'); return; }
      if(Date.now()-started>8000){
        if(po)po.disconnect();
        if(window.console) console.warn('HERE map did not render — showing the address panel instead.');
        fb.classList.remove('gone'); return;
      }
      setTimeout(check,250);
    })();
  }
  function startMap(){
    if(!HERE_API_KEY){ return; }            /* no key yet — keep the address panel */
    initHere().catch(function(err){
      if(window.console) console.warn('HERE map unavailable:',err.message);
      fb.classList.remove('gone');
    });
  }
  if('IntersectionObserver' in window){
    var mo=new IntersectionObserver(function(es){
      if(es[0].isIntersecting){ mo.disconnect(); startMap(); }
    },{rootMargin:'200px'});
    mo.observe(d.querySelector('.map'));
  } else { startMap(); }

  /* ---------- property card → prefills the contact message ---------- */
  d.querySelectorAll('.card[data-property]').forEach(function(card){
    card.addEventListener('click',function(e){
      var ms=d.getElementById('ms'); if(!ms) return;
      e.preventDefault();

      /* if a message was already sent, bring the form back */
      var formEl=d.getElementById('cform'), sentEl=d.getElementById('sent');
      if(sentEl.classList.contains('show')){ sentEl.classList.remove('show'); formEl.style.display=''; }

      var name=card.getAttribute('data-property'),
          detail=card.getAttribute('data-detail')||'',
          line='I\u2019d like more information about '+name+(detail?' ('+detail+')':'')+'.';

      if(ms.value.indexOf(name)===-1){
        var cur=ms.value.replace(/\s+$/,'');
        ms.value = cur ? cur+'\n\n'+line+' ' : line+' ';
      }

      d.getElementById('contact').scrollIntoView({behavior:reduce?'auto':'smooth'});
      setTimeout(function(){
        try{ ms.focus({preventScroll:true}); }catch(_){ ms.focus(); }
        ms.setSelectionRange(ms.value.length, ms.value.length);
      }, reduce?0:650);
    });
  });

  /* ---------- contact form → /api/contact (Resend) ---------- */
  var f=d.getElementById('cform'), msg=d.getElementById('fmsg'),
      sub=d.getElementById('submit'), sublabel=d.getElementById('sublabel'),
      subicon=d.getElementById('subicon'), sentPanel=d.getElementById('sent');

  function fail(text,el){
    msg.textContent=text; msg.classList.add('show','err');
    if(el){ el.setAttribute('aria-invalid','true'); el.focus(); }
  }
  function clearErrors(){
    msg.classList.remove('show','err'); msg.textContent='';
    f.querySelectorAll('[aria-invalid]').forEach(function(el){el.removeAttribute('aria-invalid')});
  }
  function busy(on){
    sub.disabled=on;
    sublabel.textContent=on?'Sending…':'Send message';
    subicon.style.display=on?'none':'';
    var s=d.getElementById('spinner');
    if(on&&!s){ var i2=d.createElement('span'); i2.className='spin'; i2.id='spinner'; sub.appendChild(i2); }
    if(!on&&s){ s.remove(); }
  }

  f.addEventListener('submit',function(e){
    e.preventDefault();
    clearErrors();
    var fn=d.getElementById('fn'), em=d.getElementById('em');
    if(!fn.value.trim()) return fail('Please add your first name so we know who we’re talking to.',fn);
    if(!/^[^@\s]+@[^@\s]+\.[^@\s]+$/.test(em.value.trim())) return fail('That email address doesn’t look right — mind checking it?',em);

    var payload={};
    new FormData(f).forEach(function(v,k){ payload[k]=v; });
    busy(true);

    fetch('/api/contact',{
      method:'POST',
      headers:{'Content-Type':'application/json'},
      body:JSON.stringify(payload)
    })
    .then(function(r){ return r.json().then(function(j){ return {ok:r.ok,body:j}; }); })
    .then(function(res){
      busy(false);
      if(!res.ok) throw new Error(res.body && res.body.error || 'Something went wrong.');
      f.style.display='none';
      sentPanel.classList.add('show');
      sentPanel.scrollIntoView({behavior:reduce?'auto':'smooth',block:'center'});
    })
    .catch(function(err){
      busy(false);
      fail(err.message+' You can also reach us at 303-998-1100 or info@newoptionpartners.com.');
    });
  });

  d.getElementById('yr').textContent=new Date().getFullYear();
})();
</script>
