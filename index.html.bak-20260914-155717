<style>
:root{
  --ink:#0E1D26;
  --ink-2:#16303F;
  --slate:#24506C;
  --brass:#B08240;
  --brass-lo:#C9A06A;
  --brass-hi:#E2C08A;
  --paper:#F7F6F3;
  --paper-2:#EFEDE8;
  --line:#E1DDD5;
  --muted:#5F6E77;
  --maxw:1240px;
  --pad:clamp(20px,5vw,64px);
  --r:2px;
  --ease:cubic-bezier(.22,.61,.36,1);
  --hdr:84px;
}
*{box-sizing:border-box}
html{scroll-behavior:smooth;-webkit-text-size-adjust:100%}
body{
  margin:0;background:var(--paper);color:var(--ink);
  font-family:Inter,-apple-system,BlinkMacSystemFont,"Segoe UI",Helvetica,Arial,sans-serif;
  font-size:16px;line-height:1.65;-webkit-font-smoothing:antialiased;
  overflow-x:hidden;
}
img{max-width:100%;display:block}
a{color:inherit}
button{font:inherit;color:inherit}
h1,h2,h3,h4{font-family:Archivo,Inter,sans-serif;font-weight:700;letter-spacing:-.028em;line-height:1.06;margin:0}
p{margin:0 0 1em}
section[id]{scroll-margin-top:calc(var(--hdr) + 8px)}
.wrap{max-width:var(--maxw);margin:0 auto;padding-inline:var(--pad)}
.sr{position:absolute;width:1px;height:1px;padding:0;margin:-1px;overflow:hidden;clip:rect(0 0 0 0);white-space:nowrap;border:0}

/* visible focus everywhere */
:focus-visible{outline:2px solid var(--brass);outline-offset:3px;border-radius:1px}
.on-ink :focus-visible,.hero :focus-visible,.contact-band :focus-visible,.svc-band :focus-visible,.ftr :focus-visible,.mnav :focus-visible{outline-color:var(--brass-hi)}
.skip{
  position:fixed;top:8px;left:8px;z-index:200;background:var(--ink);color:#fff;
  padding:12px 18px;border-radius:var(--r);font-size:14px;font-weight:600;text-decoration:none;
  transform:translateY(-160%);transition:transform .2s var(--ease);
}
.skip:focus{transform:none}

.eyebrow{
  font-size:11px;font-weight:600;letter-spacing:.18em;text-transform:uppercase;
  color:var(--brass);display:flex;align-items:center;gap:12px;margin:0 0 18px;
}
.eyebrow::before{content:"";width:26px;height:1px;background:var(--brass);opacity:.6;flex:none}
.eyebrow.on-dark{color:var(--brass-hi)}
.eyebrow.on-dark::before{background:var(--brass-hi)}

/* ---------- image skeletons ---------- */
.ph{position:relative;overflow:hidden;background:var(--sk,#DDD9D2)}
.ph::after{
  content:"";position:absolute;inset:0;pointer-events:none;
  background:linear-gradient(100deg,transparent 20%,rgba(255,255,255,.42) 50%,transparent 80%);
  transform:translateX(-100%);animation:shimmer 1.7s var(--ease) infinite;
}
.ph.dark::after{background:linear-gradient(100deg,transparent 20%,rgba(255,255,255,.14) 50%,transparent 80%)}
.ph.is-loaded::after{animation:none;opacity:0;transition:opacity .4s var(--ease)}
.ph>img{opacity:0;transition:opacity .7s var(--ease),transform .7s var(--ease)}
.ph.is-loaded>img{opacity:1}
@keyframes shimmer{to{transform:translateX(100%)}}

/* ---------- buttons ---------- */
.btn{
  display:inline-flex;align-items:center;justify-content:center;gap:10px;padding:14px 26px;
  border:1px solid transparent;border-radius:var(--r);font-size:14px;font-weight:600;letter-spacing:.01em;
  text-decoration:none;cursor:pointer;transition:.28s var(--ease);white-space:nowrap;
}
.btn-primary{background:var(--brass);color:#fff;border-color:var(--brass)}
.btn-primary:hover{background:#9A6E32;border-color:#9A6E32;transform:translateY(-1px)}
.btn-primary[disabled]{opacity:.6;cursor:progress;transform:none}
.btn-ghost{background:transparent;color:#fff;border-color:rgba(255,255,255,.5)}
.btn-ghost:hover{background:rgba(255,255,255,.12);border-color:#fff}
.btn-dark{background:var(--ink);color:#fff;border-color:var(--ink)}
.btn-dark:hover{background:var(--ink-2);border-color:var(--ink-2);transform:translateY(-1px)}
.btn svg{width:14px;height:14px;flex:none}
.spin{width:14px;height:14px;border:1.6px solid rgba(255,255,255,.4);border-top-color:#fff;border-radius:50%;animation:sp .7s linear infinite;flex:none}
@keyframes sp{to{transform:rotate(360deg)}}

/* ---------- header ---------- */
.hdr{
  position:fixed;inset:0 0 auto 0;z-index:60;
  transition:background .35s var(--ease),border-color .35s var(--ease);
  border-bottom:1px solid transparent;
}
.hdr-in{display:flex;align-items:center;justify-content:space-between;gap:24px;height:var(--hdr);
  max-width:var(--maxw);margin:0 auto;padding-inline:var(--pad)}
.brand{display:flex;align-items:center;text-decoration:none;flex:none;padding:10px 0}
.brand img{height:24px;width:auto;transition:opacity .3s var(--ease)}
.brand .lg-light{position:absolute}
.brand-wrap{position:relative;display:flex;align-items:center;height:26px}
.nav{display:flex;align-items:center;gap:34px}
.nav a{
  font-size:13.5px;font-weight:500;text-decoration:none;color:#fff;opacity:.86;white-space:nowrap;
  transition:.25s var(--ease);position:relative;padding:4px 0;
}
.nav a::after{content:"";position:absolute;left:0;right:100%;bottom:0;height:1px;background:currentColor;transition:right .3s var(--ease)}
.nav a:hover,.nav a.active{opacity:1}
.nav a:hover::after,.nav a.active::after{right:0}
.nav a.active{color:var(--brass-hi)}
.hdr.solid .nav a.active{color:var(--brass)}
.hdr-cta{display:flex;align-items:center;gap:18px}
.hdr-phone{font-size:13.5px;font-weight:600;text-decoration:none;color:#fff;letter-spacing:.01em;padding:11px 2px;white-space:nowrap}
.hdr.solid{background:rgba(247,246,243,.94);-webkit-backdrop-filter:blur(14px);backdrop-filter:blur(14px);border-bottom-color:var(--line)}
.hdr.solid .nav a,.hdr.solid .hdr-phone{color:var(--ink)}
.hdr.solid .lg-light{opacity:0}
.hdr:not(.solid) .lg-dark{opacity:0}
.hdr.solid .btn-ghost{color:var(--ink);border-color:rgba(14,29,38,.28)}
.hdr.solid .btn-ghost:hover{background:var(--ink);color:#fff;border-color:var(--ink)}
.prog{position:absolute;left:0;bottom:-1px;height:2px;width:100%;transform:scaleX(0);transform-origin:0 50%;background:var(--brass);opacity:0;transition:opacity .3s var(--ease)}
.hdr.solid .prog{opacity:1}
.burger{display:none;background:none;border:0;padding:0;cursor:pointer;position:relative;width:42px;height:42px;margin-right:-9px}
.burger span{
  position:absolute;top:50%;left:10px;width:22px;height:1.5px;margin-top:-.75px;
  background:#fff;border-radius:2px;transition:transform .34s var(--ease),background-color .35s var(--ease);
}
.burger span:nth-child(1){transform:translateY(-3.5px)}
.burger span:nth-child(2){transform:translateY(3.5px)}
.burger[aria-expanded="true"] span:nth-child(1){transform:rotate(45deg)}
.burger[aria-expanded="true"] span:nth-child(2){transform:rotate(-45deg)}
.hdr.solid .burger span{background:var(--ink)}

/* ---------- mobile nav ---------- */
.mnav{
  position:fixed;inset:0;background:var(--ink);z-index:55;display:flex;flex-direction:column;
  justify-content:center;padding:0 var(--pad);gap:6px;
  opacity:0;visibility:hidden;pointer-events:none;
  transition:opacity .32s var(--ease),visibility .32s var(--ease);
}
.mnav.open{opacity:1;visibility:visible;pointer-events:auto}
.mnav a{font-family:Archivo;font-size:clamp(28px,8vw,44px);font-weight:700;color:#fff;text-decoration:none;padding:10px 0;letter-spacing:-.03em}
.mnav>a,.mnav>.m-contact{opacity:0;transform:translateY(12px);transition:opacity .42s var(--ease),transform .42s var(--ease)}
.mnav.open>a,.mnav.open>.m-contact{opacity:1;transform:none}
.mnav.open>a:nth-of-type(1){transition-delay:.08s}
.mnav.open>a:nth-of-type(2){transition-delay:.13s}
.mnav.open>a:nth-of-type(3){transition-delay:.18s}
.mnav.open>a:nth-of-type(4){transition-delay:.23s}
.mnav.open>a:nth-of-type(5){transition-delay:.28s}
.mnav.open>.m-contact{transition-delay:.34s}
.m-contact{margin-top:32px;padding-top:28px;border-top:1px solid rgba(255,255,255,.15)}
.m-contact a{font-family:Inter;font-size:16px;font-weight:500;display:block;padding:8px 0;color:rgba(255,255,255,.72);letter-spacing:0}

/* ---------- hero ---------- */
.hero{
  position:relative;overflow:hidden;background:var(--ink);
  display:flex;flex-direction:column;justify-content:flex-end;
  min-height:min(100svh,920px);
}
.slides{position:absolute;inset:0}
.slide{position:absolute;inset:0;opacity:0;transition:opacity 1.15s var(--ease)}
.slide.on{opacity:1;z-index:1}
.slide,.slide .ph{width:100%;height:100%}
.slide img{width:100%;height:100%;object-fit:cover;transform:scale(1.06);transition:transform 8s linear,opacity .7s var(--ease)}
.slide.on .ph.is-loaded img{transform:scale(1)}
.hero::after{
  content:"";position:absolute;inset:0;pointer-events:none;z-index:2;
  background:
    linear-gradient(to top,rgba(6,16,22,.88) 0%,rgba(6,16,22,.45) 42%,rgba(6,16,22,.12) 70%,rgba(6,16,22,.5) 100%),
    linear-gradient(to right,rgba(6,16,22,.5),rgba(6,16,22,0) 62%);
}
.hero-in{
  position:relative;z-index:3;width:100%;max-width:var(--maxw);margin:0 auto;
  padding:clamp(94px,13vh,124px) var(--pad) clamp(32px,6vh,76px);
  display:flex;flex-direction:column;justify-content:flex-end;
  text-shadow:0 2px 30px rgba(6,16,22,.5);
}
.hero h1{color:#fff;font-size:max(30px,min(clamp(33px,calc(19px + 5vw),76px),11vh));max-width:17ch;margin:0 0 22px;letter-spacing:-.035em}
.hero h1 em{font-style:normal;color:var(--brass-lo)}
.hero-sub{color:rgba(255,255,255,.82);font-size:clamp(16px,1.55vw,19px);max-width:52ch;margin:0 0 34px;line-height:1.6}
.hero-actions{display:flex;flex-wrap:wrap;gap:12px}
.hero-foot{
  position:relative;z-index:3;margin-top:clamp(36px,6vh,64px);
  display:flex;align-items:flex-end;justify-content:space-between;gap:24px;
  border-top:1px solid rgba(255,255,255,.2);padding-top:20px;
}
.hero-count{font-family:Archivo;font-size:13px;color:rgba(255,255,255,.75);letter-spacing:.08em;font-variant-numeric:tabular-nums}
.hero-count b{color:#fff;font-weight:600}
.dots{display:flex;gap:8px;align-items:center}
.dot{
  width:34px;height:3px;background:rgba(255,255,255,.26);border:0;padding:0;cursor:pointer;
  position:relative;border-radius:3px;overflow:hidden;
  transition:width .4s var(--ease),background-color .4s var(--ease);
}
.dot:hover{background:rgba(255,255,255,.45)}
.dot::after{content:"";position:absolute;inset:-15px -5px;border-radius:0}
.dot.on{width:58px;background:rgba(255,255,255,.34)}
.dot i{position:absolute;inset:0 100% 0 0;background:var(--brass-hi);border-radius:3px;transition:right .3s linear}
.dot.on i{right:0;transition:right 6s linear}
.arrows{display:flex;gap:8px}
.arw{
  width:44px;height:44px;border:1px solid rgba(255,255,255,.35);background:rgba(255,255,255,.06);
  border-radius:50%;display:grid;place-items:center;cursor:pointer;transition:.28s var(--ease);
  -webkit-backdrop-filter:blur(6px);backdrop-filter:blur(6px);
}
.arw:hover{background:#fff;border-color:#fff}
.arw svg{width:15px;height:15px;stroke:#fff;transition:stroke .28s var(--ease)}
.arw:hover svg{stroke:var(--ink)}

/* ---------- sections ---------- */
.sec{padding:clamp(72px,10vw,136px) 0}
h2.big{font-size:clamp(30px,4.3vw,52px);max-width:19ch;letter-spacing:-.03em}
.lede{font-size:clamp(16px,1.4vw,18.5px);color:var(--muted);line-height:1.72}

/* about */
.about-grid{display:grid;grid-template-columns:1.05fr .95fr;gap:clamp(32px,6vw,88px);align-items:start}
.about-copy p{max-width:56ch}
.about-media{position:relative}
.about-media .ph{aspect-ratio:3/2;border-radius:var(--r)}
.about-media img{width:100%;height:100%;object-fit:cover}
.about-media .badge{position:absolute;left:-1px;bottom:-1px;background:var(--ink);color:#fff;padding:22px 26px;max-width:78%;z-index:2}
.about-media .badge b{display:block;font-family:Archivo;font-size:13px;letter-spacing:.14em;text-transform:uppercase;color:var(--brass-lo);margin-bottom:6px;font-weight:600}
.about-media .badge span{font-size:14.5px;line-height:1.5;color:rgba(255,255,255,.86)}
.stats{display:grid;grid-template-columns:repeat(3,1fr);margin-top:clamp(48px,6vw,72px);border-top:1px solid var(--line)}
.stat{padding:32px 28px 4px;border-right:1px solid var(--line)}
.stat:last-child{border-right:0}
.stat b{display:block;font-family:Archivo;font-weight:700;font-size:clamp(34px,4.4vw,52px);letter-spacing:-.035em;line-height:1;color:var(--ink)}
.stat span{display:block;margin-top:12px;font-size:13.5px;color:var(--muted);line-height:1.5;max-width:24ch}

/* services */
.svc-band{background:var(--ink);color:#fff}
.svc-band h2.big{color:#fff}
.svc-band .lede{color:rgba(255,255,255,.68)}
.svc-head{display:grid;grid-template-columns:1fr .8fr;gap:clamp(28px,5vw,72px);align-items:end;margin-bottom:clamp(44px,6vw,72px)}
.svc-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:1px;background:rgba(255,255,255,.14)}
.svc{background:var(--ink);padding:34px 28px 38px;transition:background .35s var(--ease)}
.svc:hover{background:var(--ink-2)}
.svc .num{font-family:Archivo;font-size:12px;letter-spacing:.14em;color:var(--brass-lo);font-weight:600;display:block;margin-bottom:26px}
.svc h3{font-size:19px;letter-spacing:-.02em;margin-bottom:12px;line-height:1.25}
.svc p{font-size:14.5px;color:rgba(255,255,255,.66);line-height:1.65;margin:0}

/* properties */
.prop-head{display:flex;align-items:flex-end;justify-content:space-between;gap:20px 24px;flex-wrap:wrap;margin-bottom:38px}
.prop-actions{display:flex;align-items:center;gap:20px;flex-wrap:wrap}
.rail{
  display:flex;gap:24px;overflow-x:auto;scroll-snap-type:x mandatory;
  padding-inline:var(--pad);margin-inline:calc(var(--pad)*-1);
  scrollbar-width:none;-ms-overflow-style:none;scroll-padding-left:var(--pad);
}
.rail::-webkit-scrollbar{display:none}
.card{flex:0 0 clamp(280px,31%,388px);scroll-snap-align:start;text-decoration:none;color:inherit;display:block}
.card .ph{aspect-ratio:4/3;border-radius:var(--r)}
.card img{width:100%;height:100%;object-fit:cover;transition:transform .7s var(--ease),opacity .7s var(--ease)}
.card:hover .ph.is-loaded img{transform:scale(1.05)}
.card-meta{padding-top:18px;display:flex;align-items:flex-start;justify-content:space-between;gap:16px}
.card h3{font-size:19px;letter-spacing:-.02em;margin-bottom:6px;display:flex;align-items:center;gap:9px}
.card h3 svg{width:14px;height:14px;opacity:0;transform:translateX(-5px);transition:.3s var(--ease);stroke:var(--brass);flex:none}
.card:hover h3 svg{opacity:1;transform:none}
.card .type{font-size:13px;color:var(--muted);margin:0}
.tag{font-size:10.5px;font-weight:600;letter-spacing:.12em;text-transform:uppercase;padding:5px 10px;border:1px solid var(--line);color:var(--muted);flex:none;border-radius:var(--r)}
.rail-nav{display:flex;gap:8px}
.arw-lt{width:42px;height:42px;border:1px solid var(--line);background:transparent;border-radius:50%;display:grid;place-items:center;cursor:pointer;transition:.28s var(--ease)}
.arw-lt:hover{background:var(--ink);border-color:var(--ink)}
.arw-lt svg{width:14px;height:14px;stroke:var(--ink);transition:stroke .28s var(--ease)}
.arw-lt:hover svg{stroke:#fff}
.arw-lt:disabled{opacity:.3;cursor:default}
.arw-lt:disabled:hover{background:transparent;border-color:var(--line)}
.arw-lt:disabled:hover svg{stroke:var(--ink)}
.rail-bar{display:none;height:2px;background:var(--line);margin-top:26px;position:relative;border-radius:2px}
.rail-bar i{position:absolute;inset:0 auto 0 0;width:30%;background:var(--brass);border-radius:2px;transition:transform .12s linear}

/* team */
.team-band{background:var(--paper-2)}
.team-grid{display:grid;grid-template-columns:1fr 1fr;gap:clamp(28px,4.5vw,64px)}
.person{background:var(--paper);border:1px solid var(--line);border-radius:var(--r);overflow:hidden;display:flex;flex-direction:column}
.person .ph{aspect-ratio:4/5;max-height:520px}
.person img{width:100%;height:100%;object-fit:cover;object-position:center 18%;filter:saturate(.94)}
.person-body{padding:clamp(24px,3vw,34px)}
.person h3{font-size:clamp(22px,2.4vw,27px);letter-spacing:-.025em}
.person .role{font-size:11.5px;font-weight:600;letter-spacing:.15em;text-transform:uppercase;color:var(--brass);margin:10px 0 18px}
.person p{font-size:15px;color:var(--muted);line-height:1.7;margin:0 0 .95em}
.bio-more{display:none}
.bio-more.open{display:block;animation:fade .4s var(--ease)}
@keyframes fade{from{opacity:0;transform:translateY(-4px)}to{opacity:1;transform:none}}
.bio-toggle{background:none;border:0;padding:9px 0 8px;margin-top:2px;cursor:pointer;font-size:13px;font-weight:600;color:var(--ink);display:inline-flex;align-items:center;gap:8px;letter-spacing:.02em;transition:.25s var(--ease)}
.bio-toggle span{border-bottom:1px solid var(--brass);padding-bottom:3px}
.bio-toggle:hover{color:var(--brass)}
.bio-toggle svg{width:11px;height:11px;transition:transform .3s var(--ease)}
.bio-toggle[aria-expanded="true"] svg{transform:rotate(180deg)}
.person-links{display:flex;flex-wrap:wrap;gap:4px 20px;margin-top:20px;padding-top:12px;border-top:1px solid var(--line)}
.person-links a{font-size:13.5px;text-decoration:none;color:var(--muted);transition:color .25s var(--ease);display:inline-flex;align-items:center;gap:7px;padding:10px 0}
.person-links a:hover{color:var(--ink)}
.person-links svg{width:13px;height:13px;stroke:currentColor;flex:none}

/* contact */
.contact-band{background:var(--ink);color:#fff}
.contact-band h2.big{color:#fff}
.contact-grid{display:grid;grid-template-columns:1.02fr .98fr;gap:clamp(36px,5.5vw,80px);align-items:start}
.field{margin-bottom:20px}
.field label{display:block;font-size:11.5px;font-weight:600;letter-spacing:.13em;text-transform:uppercase;color:rgba(255,255,255,.55);margin-bottom:9px}
.field input,.field textarea{
  width:100%;background:transparent;border:0;border-bottom:1px solid rgba(255,255,255,.25);
  padding:11px 0;color:#fff;font:inherit;font-size:15.5px;transition:border-color .3s var(--ease);border-radius:0;
}
.field input:focus,.field textarea:focus{outline:none;border-bottom-color:var(--brass-hi)}
.field input:focus-visible,.field textarea:focus-visible{outline:none}
.field input[aria-invalid="true"],.field textarea[aria-invalid="true"]{border-bottom-color:#E08A6B}
.field input::placeholder,.field textarea::placeholder{color:rgba(255,255,255,.3)}
.field textarea{resize:vertical;min-height:96px;line-height:1.6}
.frow{display:grid;grid-template-columns:1fr 1fr;gap:22px}
#cform{position:relative}
.hp{position:absolute;width:1px;height:1px;padding:0;margin:-1px;overflow:hidden;clip:rect(0 0 0 0);clip-path:inset(50%);white-space:nowrap;border:0}
.form-note{font-size:12.5px;color:rgba(255,255,255,.42);margin:18px 0 0;line-height:1.6}
.form-note a{color:rgba(255,255,255,.66);padding:8px 1px}
.form-msg{display:none;margin-top:20px;padding:14px 16px;border-left:2px solid var(--brass);background:rgba(255,255,255,.04);font-size:14.5px;line-height:1.6;border-radius:0 var(--r) var(--r) 0}
.form-msg.show{display:block;animation:fade .35s var(--ease)}
.form-msg.err{border-left-color:#E08A6B;color:#F0BCA8}
.sent{display:none;padding:38px 0}
.sent.show{display:block;animation:fade .45s var(--ease)}
.sent .tick{width:46px;height:46px;border-radius:50%;border:1px solid var(--brass);display:grid;place-items:center;margin-bottom:22px}
.sent .tick svg{width:20px;height:20px;stroke:var(--brass-hi)}
.sent h3{font-size:26px;color:#fff;margin-bottom:12px}
.sent p{color:rgba(255,255,255,.66);max-width:40ch;font-size:15.5px}
.info{display:grid;border-top:1px solid rgba(255,255,255,.16);margin-bottom:30px}
.info a{
  display:grid;grid-template-columns:120px 1fr;gap:20px;padding:20px 0;
  border-bottom:1px solid rgba(255,255,255,.16);text-decoration:none;color:#fff;
  transition:padding-left .3s var(--ease);align-items:baseline;
}
.info a:hover{padding-left:8px}
.info .k{font-size:11.5px;font-weight:600;letter-spacing:.13em;text-transform:uppercase;color:rgba(255,255,255,.5)}
.info .v{font-size:16px;line-height:1.5}
.info .v small{display:block;font-size:13.5px;color:rgba(255,255,255,.55);margin-top:3px}

/* map */
.map{position:relative;aspect-ratio:16/10;border:1px solid rgba(255,255,255,.16);overflow:hidden;background:var(--ink-2);border-radius:var(--r)}
.map-canvas{position:absolute;inset:0;filter:saturate(.88) contrast(1.02)}
.map-canvas .H_ib_body{font-family:Inter,sans-serif}
.map-fb{
  position:absolute;inset:0;z-index:2;display:flex;flex-direction:column;justify-content:flex-end;
  padding:26px;gap:5px;background:linear-gradient(135deg,#1B3C4E,#0E1D26);
  transition:opacity .5s var(--ease);
}
.map-fb.gone{opacity:0;pointer-events:none}
.map-fb .grid{position:absolute;inset:0;opacity:.16;
  background-image:linear-gradient(rgba(255,255,255,.4) 1px,transparent 1px),linear-gradient(90deg,rgba(255,255,255,.4) 1px,transparent 1px);
  background-size:44px 44px;-webkit-mask-image:radial-gradient(circle at 50% 45%,#000,transparent 72%);mask-image:radial-gradient(circle at 50% 45%,#000,transparent 72%)}
.map-fb .pin{position:absolute;left:50%;top:42%;transform:translate(-50%,-50%)}
.map-fb .pin span{display:block;width:13px;height:13px;border-radius:50%;background:var(--brass);box-shadow:0 0 0 6px rgba(176,130,64,.28),0 0 0 14px rgba(176,130,64,.13)}
.map-fb b{font-family:Archivo;font-size:16px;position:relative}
.map-fb em{font-style:normal;font-size:13.5px;color:rgba(255,255,255,.6);position:relative}
.map-fb a{color:var(--brass-hi);font-size:13.5px;text-decoration:none;margin-top:4px;font-weight:600;padding:9px 0;align-self:flex-start;position:relative}
.map-cap{font-size:12.5px;color:rgba(255,255,255,.4);margin:12px 0 0}
.map-cap a{color:rgba(255,255,255,.6);padding:8px 1px}

/* footer */
.ftr{background:#0A161D;color:rgba(255,255,255,.55);padding:52px 0 44px;font-size:13.5px}
.ftr-in{display:flex;flex-wrap:wrap;gap:28px;align-items:center;justify-content:space-between}
.ftr img{height:19px;width:auto;opacity:.5}
.ftr-nav{display:flex;gap:2px 26px;flex-wrap:wrap}
.ftr-nav a{text-decoration:none;transition:color .25s var(--ease);padding:9px 0}
.ftr-nav a:hover{color:#fff}

/* reveal */
.rv{opacity:0;transform:translateY(22px);transition:opacity .8s var(--ease),transform .8s var(--ease)}
.rv.in{opacity:1;transform:none}

